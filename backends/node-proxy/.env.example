# ============================================================================
# Gemini Enterprise (Vertex AI Discovery Engine) Target Configuration
# ============================================================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=global
GE_ENGINE_ID=your-agentspace-engine-id
GE_WIDGET_CONFIG_ID=your-widget-config-uuid

# Optional: semicolon-separated data store resource names for streamAssist grounding
# GE_DATA_STORES=projects/.../dataStores/confluence;projects/.../dataStores/sharepoint

# ============================================================================
# Identity Transform Strategy (Customer-Agnostic Email Mapping)
# ============================================================================
# Options: passthrough (default) | domain_rewrite | claim_template
GE_IDENTITY_STRATEGY=passthrough

# Optional target Cloud Identity domain (used by domain_rewrite and claim_template)
# GE_IDENTITY_DOMAIN=company.com
# GE_IDENTITY_SOURCE_DOMAIN=corp.company.com
# GE_IDENTITY_TEMPLATE={given_name}.{family_name}@{domain}

# Match Gemini Enterprise Web App session history (sets session.userPseudoId = numeric sessionId)
GE_USER_PSEUDO_ID_MATCH_SESSION=true
GE_DEEP_LINK_INCLUDE_SESSION=true

# ============================================================================
# Enterprise Auth Modes (Choose any combination)
# ============================================================================
# Pattern 1: Browser-Side Per-User Google OAuth 2.0 (Google Identity Services with login_hint)
# GOOGLE_OAUTH_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# Pattern 2: Server-Side Per-User Google OAuth 2.0 Authorization Code + PKCE + Encrypted Refresh Token Cookie
#   (Recommended when you want one-time per-user sign-in with automatic server-side refresh_token rotation)
# GOOGLE_OAUTH_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
# GOOGLE_OAUTH_REDIRECT_URI=https://your-intranet-proxy.example.com/api/auth/google/callback
# GOOGLE_OAUTH_COOKIE_SECRET=replace-with-random-32-byte-secret

# Pattern 3: Workforce Identity Federation (WIF STS Token Exchange from Entra/Okta JWT)
# GE_STS_AUDIENCE=//iam.googleapis.com/locations/global/workforcePools/<POOL>/providers/<PROVIDER>

# Pattern 4: Cloud Run IAP / Azure EasyAuth headers are detected automatically:
#   - X-Goog-Authenticated-User-Email
#   - X-MS-CLIENT-PRINCIPAL-NAME

# Pattern 5: Service Account Domain-Wide Delegation (impersonate resolved user email)
# GE_IMPERSONATE_USER=false

