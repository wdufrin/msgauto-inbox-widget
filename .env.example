# ==============================================================================
# Gemini Enterprise Omnibar (<gemini-omnibar>) — Environment Template
# Copy this file to .env and fill in your Google Cloud / Gemini Enterprise IDs:
#   cp .env.example .env
# ==============================================================================

# 1. Google Cloud & Gemini Enterprise Engine Configuration (Required)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=global
GE_COLLECTION_ID=default_collection
GE_ENGINE_ID=your-gemini-engine-id

# Optional: Discovery Engine Search Widget Config ID (only used if embedding <gen-search-widget>)
GE_WIDGET_CONFIG_ID=00000000-0000-0000-0000-000000000000

# 2. Local / Default Identity (used for local development when no SSO header is present)
GE_DEFAULT_USER_EMAIL=jane.doe@acme.com

# 3. Optional: Browser-Side Google Identity Services (GIS) OAuth Client ID
# Used when auth-mode="gis" or when testing Pattern 4 (Browser-Direct OAuth)
GOOGLE_OAUTH_CLIENT_ID=

# 4. Optional: Server-Side OAuth 2.0 + PKCE (Pattern 2)
# Enables automatic silent token refresh via encrypted HttpOnly cookies
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
GE_COOKIE_SECRET=replace-with-32-byte-random-hex-secret

# 5. Optional: Identity Transform Strategy (passthrough | domain_rewrite | claim_template)
GE_IDENTITY_STRATEGY=passthrough
# GE_TARGET_EMAIL_DOMAIN=acme.com

# 6. Local Proxy Server Port
PORT=8080
